{
  "name": "interview-alpha",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node server.js\" \"vite\"",
    "dev:staging": "VITE_APP_ENV=staging concurrently \"node server.js\" \"vite\"",
    "build": "vite build",
    "build:staging": "VITE_APP_ENV=staging vite build",
    "build:prod": "VITE_APP_ENV=production vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "node server.js",
    "test:mobile": "playwright test tests/mobile.spec.js",
    "test:mobile:report": "playwright test tests/mobile.spec.js --reporter=html && playwright show-report tests/report"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.3",
    "concurrently": "^9.2.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "http-proxy-middleware": "^3.0.5",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "resend": "^6.12.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^8.0.1"
  }
}
