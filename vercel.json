{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/messages", "destination": "/api/messages" },
    { "source": "/api/send-emails", "destination": "/api/send-emails" }
  ],
  "crons": [
    {
      "path": "/api/send-emails",
      "schedule": "0 3 * * *"
    }
  ]
}
